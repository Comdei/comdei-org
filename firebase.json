{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "CNAME",
      "README*",
      "infra/**",
      "tests/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/ig/claudio",
        "destination": "/catequese-infantil?utm_source=instagram&utm_medium=stories&utm_campaign=catequese_lapa&utm_content=claudio_andre",
        "type": 302
      },
      {
        "source": "/ig/mercadores",
        "destination": "/catequese-infantil?utm_source=instagram&utm_medium=stories&utm_campaign=catequese_lapa&utm_content=lapa_mercadores",
        "type": 302
      }
    ]
  }
}
